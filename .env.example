# Run python3 scripts/init_env.py to generate .env with local credentials.
# This file documents configuration; it contains no usable generated secrets.
# Endpoint domain for the OpenSandbox SDK. Its protocol defaults to HTTP.
OPEN_SANDBOX_DOMAIN=127.0.0.1:8080
# The runner and trusted control server share this key; workloads never receive it.
OPEN_SANDBOX_API_KEY=__GENERATE__
# Python workload image used for disposable ledger executions.
SANDBOX_IMAGE=python:3.12-slim-bookworm
# Local Langfuse UI/API origin, also used as the web authentication origin.
LANGFUSE_BASE_URL=http://localhost:3000
# Bootstrap creates a local project with these SDK keys on its first startup.
LANGFUSE_PUBLIC_KEY=pk-lf-__GENERATE__
LANGFUSE_SECRET_KEY=sk-lf-__GENERATE__
# Credentials for signing into the local UI, separate from project API access.
LANGFUSE_USER_EMAIL=developer@example.test
LANGFUSE_USER_PASSWORD=__GENERATE__
# Independent credentials for Langfuse's internal database, queue, and object store.
POSTGRES_PASSWORD=__GENERATE__
CLICKHOUSE_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
MINIO_ROOT_PASSWORD=__GENERATE__
# Application session secret, hashing salt, and a 32-byte hexadecimal encryption key.
NEXTAUTH_SECRET=__GENERATE__
SALT=__GENERATE__
ENCRYPTION_KEY=__GENERATE__
